# TigerGraph Connection Settings (Savanna Cloud or Community Edition)
TG_HOST=https://your-domain.i.tgcloud.io
TG_GRAPH=FraudInvestigation
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_SECRET=your_secret
TG_API_TOKEN=

# Graph Execution Mode: "embedded" (fast local engine) or "tigergraph" (remote TG instance)
GRAPH_MODE=embedded

# LLM & Embedding Settings
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Policy & Investigation Config
CONFIG_PATH=config
BENCHMARK_CASES_PATH=data/case_pack.csv
CLOSED_CASES_PATH=data/closed_cases_history.csv
TRANSACTIONS_PATH=data/transactions.csv
IDENTITY_PATH=data/identity.csv
OUTPUT_ANSWERS_PATH=cases
