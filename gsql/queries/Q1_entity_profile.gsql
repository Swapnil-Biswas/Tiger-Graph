// Q1: entity_profile
// Baseline behavior for customer or card
USE GRAPH FraudInvestigation

CREATE QUERY entity_profile(VERTEX<Card> target_card, STRING as_of) FOR GRAPH FraudInvestigation {
    SumAccum<DOUBLE> @total_spend = 0.0;
    SumAccum<INT> @txn_count = 0;
    ListAccum<DOUBLE> @amounts;

    Start = {target_card};

    Txns = SELECT t FROM Start:s -(MADE:e)-> Transaction:t
           WHERE t.ts <= as_of
           ACCUM s.@total_spend += t.amount,
                 s.@txn_count += 1,
                 s.@amounts += t.amount;

    PRINT Start[Start.@total_spend AS total_spend, Start.@txn_count AS txn_count];
}
INSTALL QUERY entity_profile
