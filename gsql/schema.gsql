// TigerGraph Schema for Agentic Fraud Investigator (HHGOA IEEE-CIS)
// Graph Name: FraudInvestigation

CREATE GRAPH FraudInvestigation ()

// Vertices
CREATE VERTEX Customer (
    PRIMARY_ID id STRING,
    customer_id STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Card (
    PRIMARY_ID id STRING,
    customer_id STRING,
    card_network STRING,
    card_type STRING,
    issuer_code STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Transaction (
    PRIMARY_ID id STRING,
    amount DOUBLE,
    ts STRING,
    epoch_s INT,
    product_code STRING,
    risk_score DOUBLE,
    channel STRING,
    addr1 STRING,
    addr2 STRING,
    p_email STRING,
    r_email STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX DeviceProfile (
    PRIMARY_ID id STRING,
    device_info STRING,
    device_type STRING,
    os STRING,
    browser STRING,
    screen STRING,
    proxy_status STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX EmailDomain (
    PRIMARY_ID id STRING,
    domain STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX BillingRegion (
    PRIMARY_ID id STRING,
    region_code STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX ClosedCase (
    PRIMARY_ID id STRING,
    customer_id STRING,
    card_id STRING,
    opened_at STRING,
    closed_at STRING,
    outcome STRING,
    pattern STRING,
    first_fraud_txn_id STRING,
    exposure_usd DOUBLE,
    n_txns INT,
    actions_taken STRING,
    report_filed STRING,
    analyst_notes STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Case (
    PRIMARY_ID id STRING,
    status STRING,
    risk_level DOUBLE,
    confidence DOUBLE,
    verdict STRING,
    fraud_type STRING,
    exposure_usd DOUBLE,
    opened_ts STRING,
    closed_ts STRING,
    source STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Finding (
    PRIMARY_ID id STRING,
    kind STRING,
    statement STRING,
    strength STRING,
    ts STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Evidence (
    PRIMARY_ID id STRING,
    source_query STRING,
    payload_json STRING,
    ts STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Action (
    PRIMARY_ID id STRING,
    action_type STRING,
    status STRING,
    requires_approval STRING,
    approver STRING,
    ts STRING,
    simulated BOOL
) WITH STATS="OUTDEGREE";

CREATE VERTEX FraudPattern (
    PRIMARY_ID id STRING,
    name STRING,
    description STRING,
    origin STRING
) WITH STATS="OUTDEGREE";

// Edges
CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card);
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction);
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile);
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion);
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain);
CREATE DIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain);
CREATE DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction);

CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction);
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card);
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card);

CREATE DIRECTED EDGE CASE_ABOUT (FROM Case, TO Card);
CREATE DIRECTED EDGE CASE_TXN (FROM Case, TO Transaction);
CREATE DIRECTED EDGE HAS_FINDING (FROM Case, TO Finding);
CREATE DIRECTED EDGE SUPPORTED_BY (FROM Finding, TO Evidence);
CREATE DIRECTED EDGE TOOK_ACTION (FROM Case, TO Action);
CREATE UNDIRECTED EDGE SIMILAR_TO (FROM Case, TO ClosedCase, similarity DOUBLE);

// Load schema into graph
USE GRAPH FraudInvestigation
SCHEMA_CHANGE_JOB add_fraud_schema {
    ADD VERTEX Customer;
    ADD VERTEX Card;
    ADD VERTEX Transaction;
    ADD VERTEX DeviceProfile;
    ADD VERTEX EmailDomain;
    ADD VERTEX BillingRegion;
    ADD VERTEX ClosedCase;
    ADD VERTEX Case;
    ADD VERTEX Finding;
    ADD VERTEX Evidence;
    ADD VERTEX Action;
    ADD VERTEX FraudPattern;

    ADD EDGE OWNS;
    ADD EDGE MADE;
    ADD EDGE FROM_DEVICE;
    ADD EDGE BILLED_IN;
    ADD EDGE PURCHASER_EMAIL;
    ADD EDGE RECIPIENT_EMAIL;
    ADD EDGE NEXT_TXN;
    ADD EDGE INVOLVES;
    ADD EDGE ON_CARD;
    ADD EDGE CONNECTED_TO;
    ADD EDGE CASE_ABOUT;
    ADD EDGE CASE_TXN;
    ADD EDGE HAS_FINDING;
    ADD EDGE SUPPORTED_BY;
    ADD EDGE TOOK_ACTION;
    ADD EDGE SIMILAR_TO;
}
RUN SCHEMA_CHANGE_JOB add_fraud_schema
DROP JOB add_fraud_schema
