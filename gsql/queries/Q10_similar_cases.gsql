// Q10: similar_cases
USE GRAPH FraudInvestigation

CREATE QUERY similar_cases(VERTEX<Card> target_card, STRING as_of) FOR GRAPH FraudInvestigation {
    Start = {target_card};
    CasesOnCard = SELECT cs FROM Start:s <-(ON_CARD:e)- ClosedCase:cs
                  WHERE cs.opened_at <= as_of;
    PRINT CasesOnCard;
}
INSTALL QUERY similar_cases
