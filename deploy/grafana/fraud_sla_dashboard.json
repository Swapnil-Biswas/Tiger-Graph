  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "TigerGraph Agentic Fraud Operations SLA & Telemetry",
      "type": "row"
    },
    {
      "id": 2,
      "title": "Fraud Ops SLA Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "investigation_latency_seconds_sum / investigation_latency_seconds_count * 1000",
          "legendFormat": "Avg Latency (ms)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 35 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Total Completed Investigations",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(fraud_investigations_total)",
          "legendFormat": "Total Cases",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "Streaming Transaction Throughput",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "rate(streaming_transactions_ingested_total[1m])",
          "legendFormat": "Txns / sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Total Critical Anomaly Alerts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sum(streaming_alerts_emitted_total{severity=\"CRITICAL\"}) or vector(0)",
          "legendFormat": "Critical Alerts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Investigation Latency SLA Percentiles (P50, P90, P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(investigation_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P50 Latency",
          "refId": "P50"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(investigation_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P90 Latency",
          "refId": "P90"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(investigation_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P99 Latency (SLA Target <= 50ms)",
          "refId": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Streaming Anomaly Alerts by Rule & Severity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "sum(rate(streaming_alerts_emitted_total[1m])) by (rule, severity)",
          "legendFormat": "{{rule}} ({{severity}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": { "mode": "normal" }
          },
          "unit": "alerts/min"
        }
      }
    },
    {
      "id": 8,
      "title": "Policy Actions Authorized by Role",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum(policy_actions_authorized_total) by (role, action)",
          "legendFormat": "{{role}} - {{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      }
    },
    {
      "id": 9,
      "title": "Graph Store Indexed Entities",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "graph_indexed_entities",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    }
  ],
  "refresh": "5s",
